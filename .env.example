# Nombre de quien recibe la tarjeta
VITE_RECIPIENT_NAME=YourLoveName

# Nombre de quien firma la carta (opcional)
VITE_SENDER_NAME=

# Fecha desde la que cuenta el contador (AAAA-MM-DD). Vacío = sin contador
VITE_START_DATE=2025-01-01
VITE_COUNTER_TITLE=💕 Tiempo juntos 💕

# Fotos opcionales: coloca la imagen en /public y escribe su ruta (ej. /foto.jpg)
# Vacío = la sección de la foto no se muestra
VITE_CARD_PHOTO=
VITE_CARD_PHOTO_CAPTION=
VITE_LETTER_PHOTO=
VITE_LETTER_PHOTO_CAPTION=

# Música y GIF (ruta en /public o URL). Si no se definen se usan los de por defecto
# VITE_SONG_URL=/song.mp3
# VITE_CARD_GIF_URL=https://...
